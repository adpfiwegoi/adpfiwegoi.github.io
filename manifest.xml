<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">

  <!-- ════════════════════════════════════════════════
       Liesl Tesch — Constituent Reply Assistant
       Outlook Add-in Manifest

       SETUP INSTRUCTIONS:
       1. Host taskpane.html on GitHub Pages (or similar)
       2. Replace EVERY instance of YOUR_PAGES_URL below
          with your actual URL, e.g.:
          https://yourname.github.io/constituent-reply/taskpane.html
       3. Sideload this manifest in Outlook (see setup guide)
       ════════════════════════════════════════════════ -->

  <Id>c4a7e812-3f9d-4b21-a8c6-d1e5f9023784</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Liesl Tesch Campaign Office</ProviderName>
  <DefaultLocale>en-AU</DefaultLocale>

  <DisplayName DefaultValue="Constituent Reply"/>
  <Description DefaultValue="Draft constituent email replies in Liesl's voice — offline and private."/>

  <!-- Icon: a plain red square with L — replace with real icon URL if desired -->
  <IconUrl DefaultValue="https://via.placeholder.com/32/c0392b/ffffff?text=L"/>
  <HighResolutionIconUrl DefaultValue="https://via.placeholder.com/80/c0392b/ffffff?text=L"/>
  <SupportUrl DefaultValue="https://adpfiwegoi.github.io"/>

  <AppDomains/>

  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>

  <!-- Legacy form definition (required for desktop Outlook compatibility) -->
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://adpfiwegoi.github.io/taskpane.html"/>
        <RequestedHeight>550</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <!-- Read-only: we only read the email, never send or modify -->
  <Permissions>ReadItem</Permissions>

  <!-- Activate for any inbound email -->
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>

  <!-- VersionOverrides: modern Outlook (ribbon button) -->
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.3">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>

    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <FunctionFile resid="Commands.Url"/>
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="msgReadGroup">
                <Label resid="GroupLabel"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16"/>
                  <bt:Image size="32" resid="Icon.32x32"/>
                  <bt:Image size="80" resid="Icon.80x80"/>
                </Icon>
                <Control xsi:type="Button" id="msgReadOpenPaneButton">
                  <Label resid="TaskpaneButton.Label"/>
                  <Supertip>
                    <Title resid="TaskpaneButton.Label"/>
                    <Description resid="TaskpaneButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ButtonId1</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://via.placeholder.com/16/c0392b/ffffff?text=L"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://via.placeholder.com/32/c0392b/ffffff?text=L"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://via.placeholder.com/80/c0392b/ffffff?text=L"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Commands.Url"    DefaultValue="https://adpfiwegoi.github.io/taskpane.html"/>
        <bt:Url id="Taskpane.Url"   DefaultValue="https://adpfiwegoi.github.io/taskpane.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GroupLabel"              DefaultValue="Constituent Reply"/>
        <bt:String id="TaskpaneButton.Label"    DefaultValue="Draft Reply"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="TaskpaneButton.Tooltip"  DefaultValue="Open the constituent reply assistant for this email."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>

</OfficeApp>
